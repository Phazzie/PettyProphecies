# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Secret for authentication (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CSRF Secret for CSRF token generation (minimum 32 characters)
CSRF_SECRET=your-csrf-secret-minimum-32-chars-change-in-production

# Sentry DSN for error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# xAI API Key for AI-powered tarot readings with Grok (optional)
XAI_API_KEY=your-xai-api-key

# Resend API key for transactional email (password reset)
RESEND_API_KEY=your-resend-api-key

# Public app URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging level (optional, defaults to 'info')
LOG_LEVEL=info
